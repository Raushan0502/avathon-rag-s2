# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# Generation providers, tried in this order at runtime (see src/generation.py):
# Groq -> Mistral -> Gemini. Set at least one; any subset is fine, unset ones
# are skipped. All three offer a free tier, so no billing is required.
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
